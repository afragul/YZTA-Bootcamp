# Frontend ortam degiskenleri — bu dosyayi `.env` olarak kopyalayip doldurun.
#
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# Vite yalnizca VITE_ onekli degiskenleri tarayiciya acar. Buraya GIZLI
# bir sey yazmayin: bu degerler derlenmis JS icine gomulur ve herkes gorur.

# Backend API adresi. Sonunda / OLMAMALI.
#
# Lokal gelistirme:
#   cd backend && uvicorn main:app --reload
#
# NOT: Windows'ta "localhost" IPv6 (::1) cozulebilir, backend ise 127.0.0.1
# (IPv4) dinler -> "Failed to fetch". Bu yuzden varsayilan 127.0.0.1'dir.
VITE_API_URL=http://127.0.0.1:8000

# --- Vercel dagitimi ---
# Bu dosyayi Vercel'e yuklemeyin. Bunun yerine Vercel panelinde:
#   Project Settings -> Environment Variables -> VITE_API_URL = https://<backend-adresiniz>
# Degiskenler derleme aninda gomuldugu icin, degeri degistirdikten sonra
# projeyi YENIDEN DEPLOY etmek gerekir.
#
# Ayrica backend tarafinda CORS'a Vercel adresinizin eklenmis olmasi sart;
# aksi halde tarayici tum istekleri bloklar (bkz. backend/main.py).
